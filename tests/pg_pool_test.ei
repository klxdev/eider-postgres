// The pool: bounded size under many tasks, FIFO order of waiters, exhaustion, idle timeout,
// health check of a connection the server killed, a function that traps, a connection returned
// in a transaction, closing.

import std.time
import postgres
import postgres.client
import postgres.codec
import postgres.pool
import postgres.tests.util

fn pid_of(inout c: client.Conn) -> Result[i64, postgres.Error] uses net, io, clock {
    let rs = c.query("SELECT pg_backend_pid()", List.new(), util.dl())?
    match codec.value(rs, 0, 0)? {
        postgres.Int(n) => Ok(n)
        _ => Ok(-1)
    }
}

fn config() -> postgres.Config uses io {
    var cfg = util.config("eider", "eider_pw")
    cfg.application_name = String.from("eider-pool-test")
    cfg
}

fn main() uses net, io, clock, fs, threads {
    let dl = util.dl()
    let mut admin = util.admin()

    // many tasks, three connections
    var pc = pool.pool_config()
    pc.min = 1
    pc.max = 3
    let p = pool.new(config(), pc, dl).unwrap()
    let s0 = pool.stats(p)
    print("made: max {s0.max} open {s0.open} idle {s0.idle}")
    let mut tasks: List[Task[i64]] = List.new()
    for i in 0..12 {
        tasks.push(spawn(|| -> i64 {
            let r = pool.with(p, time.after_ms(20000), |inout c| -> Result[i64, postgres.Error] {
                let rs = c.query("SELECT pg_sleep(0.05), pg_backend_pid()", List.new(), util.dl())?
                match codec.value(rs, 0, 1)? {
                    postgres.Int(n) => Ok(n)
                    _ => Ok(-1)
                }
            })
            r.unwrap_or(-2)
        }))
    }
    let mut pids: List[i64] = List.new()
    for t in tasks {
        let pid = t.join()
        if !pids.contains(pid) { pids.push(pid) }
    }
    print("distinct connections used by 12 tasks: {pids.len() <= 3 && pids.len() >= 1}, none failed: {!pids.contains(-2) && !pids.contains(-1)}")
    let s1 = pool.stats(p)
    print("after: open {s1.open <= 3} opened {s1.opened <= 3} in use {s1.in_use}")
    let rs = admin.query("SELECT count(*) FROM pg_stat_activity WHERE application_name = 'eider-pool-test'", List.new(), dl).unwrap()
    let server_side = match codec.value(rs, 0, 0).unwrap() {
        postgres.Int(n) => n
        _ => -1
    }
    print("server sees at most 3: {server_side <= 3}")

    // exhaustion: one connection, held
    var pc1 = pool.pool_config()
    pc1.max = 1
    let one = pool.new(config(), pc1, dl).unwrap()
    let held = pool.acquire(one, dl).unwrap()
    match pool.acquire(one, time.after_ms(200)) {
        Ok(l) => print("got a second connection from a pool of one?")
        Err(e) => print("exhausted: {e.kind}")
    }

    // FIFO: five tasks line up 60 ms apart; they are served in that order
    let order: Chan[i32] = Chan.new()
    let mut waiters: List[Task[i32]] = List.new()
    for i in 0..5 {
        let me = i
        let tx = order
        waiters.push(spawn(|| -> i32 {
            time.sleep_ms((me * 60) as i64)
            let l = pool.acquire(one, time.after_ms(20000)).unwrap()
            tx.send(me)
            time.sleep_ms(20)
            pool.release(one, l)
            me
        }))
    }
    time.sleep_ms(500)
    pool.release(one, held)
    let mut served = String.from("")
    for i in 0..5 {
        let who = order.recv().unwrap()
        served.append("{who} ")
    }
    for w in waiters { let r = w.join() }
    print("served in order: {served}")

    // idle timeout: a connection idle too long is replaced
    var pc2 = pool.pool_config()
    pc2.max = 2
    pc2.idle_timeout_ms = 200
    let idle = pool.new(config(), pc2, dl).unwrap()
    let first_pid = pool.with(idle, dl, |inout c| -> Result[i64, postgres.Error] { pid_of(inout c) }).unwrap()
    time.sleep_ms(500)
    let second_pid = pool.with(idle, dl, |inout c| -> Result[i64, postgres.Error] { pid_of(inout c) }).unwrap()
    print("idle connection replaced: {first_pid != second_pid}")
    let again = pool.with(idle, dl, |inout c| -> Result[i64, postgres.Error] { pid_of(inout c) }).unwrap()
    print("fresh one reused: {again == second_pid}")

    // health check: the server kills the idle connection; the next checkout notices
    var pc3 = pool.pool_config()
    pc3.max = 1
    pc3.check_after_idle_ms = 0
    let hc = pool.new(config(), pc3, dl).unwrap()
    let victim = pool.with(hc, dl, |inout c| -> Result[i64, postgres.Error] { pid_of(inout c) }).unwrap()
    let killed = admin.query("SELECT pg_terminate_backend($1)", List[postgres.Int(victim)], dl).unwrap()
    time.sleep_ms(200)
    let replacement = pool.with(hc, dl, |inout c| -> Result[i64, postgres.Error] { pid_of(inout c) }).unwrap()
    print("dead connection replaced: {replacement != victim}")

    // a trap inside with: the slot is not lost
    let t1 = pool.with(hc, dl, |inout c| -> Result[i64, postgres.Error] {
        let xs: List[i64] = List.new()
        Ok(xs[1])
    })
    match t1 {
        Ok(v) => print("no error?")
        Err(e) => print("trap: {e.kind}")
    }
    let after_trap = pool.with(hc, dl, |inout c| -> Result[i64, postgres.Error] { pid_of(inout c) })
    print("pool still works after a trap: {after_trap.is_ok()}")

    // a connection returned in a transaction is rolled back
    let z = admin.execute("DROP TABLE IF EXISTS pool_test", dl).unwrap()
    let z2 = admin.execute("CREATE TABLE pool_test (id int)", dl).unwrap()
    var l = pool.acquire(hc, dl).unwrap()
    l.conn.begin(dl).unwrap()
    let ins = l.conn.exec("INSERT INTO pool_test VALUES (1)", List.new(), dl).unwrap()
    pool.release(hc, l)
    let cnt = admin.query("SELECT count(*) FROM pool_test", List.new(), dl).unwrap()
    print("rolled back on release: {codec.value(cnt, 0, 0).unwrap()}")
    let reuse = pool.with(hc, dl, |inout c| -> Result[bool, postgres.Error] { Ok(!c.in_transaction()) })
    print("reused connection is clean: {reuse.unwrap()}")
    let z3 = admin.execute("DROP TABLE pool_test", dl).unwrap()

    // closing
    pool.close(p)
    match pool.acquire(p, dl) {
        Ok(x) => print("acquired from a closed pool?")
        Err(e) => print("closed pool: {e.kind}")
    }
    pool.close(one)
    pool.close(idle)
    pool.close(hc)
    admin.close()
    print("done")
}
