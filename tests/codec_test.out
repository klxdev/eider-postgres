parameters
  Null -> oid 0 binary false data None
  Bool(true) -> oid 0 binary false data Some([116])
  Int(-5) -> oid 0 binary false data Some([45, 53])
  Float(1.5) -> oid 0 binary false data Some([49, 46, 53])
  Float(1.0) -> oid 0 binary false data Some([49, 46, 48])
  Text("é") -> oid 0 binary false data Some([195, 169])
  Bytes([1, 2]) -> oid 17 binary true data Some([1, 2])
  Numeric("1.50") -> oid 0 binary false data Some([49, 46, 53, 48])
  Uuid("a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11") -> oid 0 binary false data Some([97, 48, 101, 101, 98, 99, 57, 57, 45, 57, 99, 48, 98, 45, 52, 101, 102, 56, 45, 98, 98, 54, 100, 45, 54, 98, 98, 57, 98, 100, 51, 56, 48, 97, 49, 49])
  Json("[]") -> oid 0 binary false data Some([91, 93])
